    "Your downloads stay on this phone and come back when you sign in to the same account." : {
      "comment" : "Sign-out confirmation dialog message",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى تنزيلاتك على هذا الهاتف وتعود عند تسجيل الدخول إلى الحساب نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Downloads bleiben auf diesem Handy und sind wieder da, sobald du dich mit demselben Konto anmeldest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your downloads stay on this phone and come back when you sign in to the same account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus descargas se quedan en este teléfono y vuelven cuando inicies sesión con la misma cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos téléchargements restent sur ce téléphone et reviennent quand vous vous reconnectez au même compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके डाउनलोड इसी फ़ोन पर रहते हैं और उसी खाते में फिर साइन इन करने पर वापस मिल जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduhan Anda tetap ada di ponsel ini dan akan muncul kembali saat Anda masuk ke akun yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi download restano su questo telefono e tornano disponibili quando accedi di nuovo allo stesso account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの曲はこのスマートフォンに残り、同じアカウントでログインすると元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 곡은 이 휴대폰에 그대로 남아 있으며, 같은 계정으로 다시 로그인하면 복원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je downloads blijven op deze telefoon staan en zijn er weer als je inlogt met hetzelfde account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrane utwory zostają na tym telefonie i wrócą, gdy zalogujesz się na to samo konto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus downloads ficam neste celular e voltam quando você entrar na mesma conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas transferências ficam neste telemóvel e voltam quando iniciar sessão na mesma conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачанное останется на этом телефоне и вернётся, когда вы войдёте в тот же аккаунт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina nedladdningar ligger kvar på den här telefonen och är tillbaka när du loggar in på samma konto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ที่ดาวน์โหลดจะยังอยู่ในโทรศัพท์เครื่องนี้ และจะกลับมาใช้ได้เมื่อคุณลงชื่อเข้าใช้บัญชีเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirdiklerin bu telefonda kalır ve aynı hesapla tekrar giriş yaptığında geri gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажене залишиться на цьому телефоні й повернеться, коли ви увійдете в той самий акаунт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản tải xuống vẫn nằm trên điện thoại này và sẽ trở lại khi bạn đăng nhập vào cùng tài khoản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的下载内容会保留在这部手机上，重新登录同一账号后即可恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的下載內容會保留在這支手機上，只要登入同一個帳號就會恢復。"
          }
        }
      }
    },
